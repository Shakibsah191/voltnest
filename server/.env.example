# Copy this file to .env and fill in the values
NODE_ENV=development
PORT=4000

# MongoDB Atlas → Connect → Drivers → copy the string, put your password in,
# and keep /voltnest before the "?" so the data goes into a database named voltnest
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/voltnest?retryWrites=true&w=majority

# Where the React app runs (comma-separate several origins if needed)
CLIENT_URL=http://localhost:5173

# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@voltnest.test
ADMIN_PASSWORD=ChangeMe123!

# Day 3: login sessions. Make each a different long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Day 4: order emails with Resend (optional). Without a key, emails print in this terminal.
# Without your own domain in Resend, keep onboarding@resend.dev and test with your sign-up email.
RESEND_API_KEY=
EMAIL_FROM=VoltNest <onboarding@resend.dev>
